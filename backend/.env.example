# Configuration PostgreSQL + pgvector
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rag_assistant

# Fournisseur LLM : 'gemini', 'openai' ou 'anthropic'
LLM_PROVIDER=gemini

# Configuration Google Gemini
GEMINI_API_KEY=votre-cle-api-gemini
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Configuration OpenAI
OPENAI_API_KEY=sk-votre-cle-api-openai
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Configuration Anthropic
ANTHROPIC_API_KEY=sk-ant-votre-cle-api-anthropic
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Paramètres du pipeline RAG
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=4
AUDIT_LOG_FILE=audit.log
